# Local development: the browser calls the backend directly.
VITE_API_BASE_URL=http://localhost:8080

# Copy this file to .env and replace this placeholder before starting Compose.
POSTGRES_DB=petstore
POSTGRES_USER=petstore
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Generate a random secret for local JWT signing; never commit your actual .env.
JWT_SECRET=replace-with-a-random-base64-secret
DEMO_USERS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
